{
  "flake": {
    "prefix": "flake",
    "body": [
      "{",
      "  description = \"${1:description}\";",
      "",
      "  inputs.nixpkgs.url = \"github:NixOS/nixpkgs/nixpkgs-unstable\";",
      "",
      "  outputs =",
      "    inputs@{ self, nixpkgs }:",
      "",
      "    let",
      "      inherit (nixpkgs) lib;",
      "      forAllSystems =",
      "        f: lib.genAttrs lib.systems.flakeExposed (system: f (import nixpkgs { inherit system; }));",
      "    in",
      "    {",
      "      nixosModules.default = import ./nix/module.nix inputs;",
      "",
      "      packages = forAllSystems (pkgs: {",
      "        default = self.packages.\\${pkgs.stdenv.hostPlatform.system}.${2:name};",
      "        ${2:name} = pkgs.callPackage ./nix/package.nix { };",
      "        $0",
      "      });",
      "",
      "      devShells = forAllSystems (pkgs: {",
      "        default = pkgs.callPackage ./nix/shell.nix { };",
      "      });",
      "    };",
      "}"
    ]
  },
  "shell": {
    "prefix": "shell",
    "body": [
      "{ mkShellNoCC }:",
      "",
      "mkShellNoCC {",
      "  packages = [",
      "    $0",
      "  ];",
      "}"
    ]
  },
  "narhash": {
    "prefix": "narhash",
    "body": [
      "${1:sha256} = \"${0:sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=}\";"
    ]
  }
}
